# ============================================================
# GraphAgent Forge — Environment Variables
# Copy to .env and fill in your keys
# ============================================================

# --- Kimi AI (Moonshot) ---
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.7-code-highspeed

# --- Neo4j Aura ---
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# --- Daytona ---
DAYTONA_API_KEY=your_daytona_api_key_here

# --- Nosana (Solana-based) ---
NOSANA_API_KEY=your_nosana_api_key_here
NOSANA_API_URL=https://dashboard.k8s.prd.nos.ci/api
# Optional: configure only if your Nosana deployment exposes embeddings.
# NOSANA_EMBEDDING_URL=https://your-deployment.example.com/embeddings

# --- App Config ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Comma-separated list of origins allowed by CORS. Defaults to localhost:8000.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: shared-secret auth for mutating routes (ingest, delete source,
# clear graph). Leave unset to disable auth entirely (fine for local/hackathon
# use). When set, clients must send it as the X-API-Key header.
# API_KEY=your_shared_secret_here

# Optional: auto-merge exact-duplicate entities at ingest (suggest-only when unset)
# AUTO_MERGE=exact
