# ============================================================
# GraphAgent Forge — Environment Variables
# Copy to .env and fill in your keys
# ============================================================

# --- Kimi AI (Moonshot) ---
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.7-code-highspeed
# Output budgets. Kimi's reasoning tokens count against max_tokens, so keep
# these generous; the app never sends `temperature` (the API only accepts 1).
# KIMI_EXTRACT_MAX_TOKENS=16384
# KIMI_ANSWER_MAX_TOKENS=4096

# --- Neo4j ---
# Managed Aura (free tier auto-deletes after 30 days of inactivity):
#   NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
# Local, via `docker compose up -d neo4j` (the demo-day default — no venue
# WiFi dependency; browser at http://localhost:7474):
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphagent-dev

# --- Daytona ---
DAYTONA_API_KEY=your_daytona_api_key_here

# --- Nosana (Solana-based) ---
NOSANA_API_KEY=your_nosana_api_key_here
NOSANA_API_URL=https://dashboard.k8s.prd.nos.ci/api
# Optional: configure only if your Nosana deployment exposes embeddings.
# NOSANA_EMBEDDING_URL=https://your-deployment.example.com/embeddings

# --- App Config ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# Dev convenience only: uvicorn's --reload restarts the process on file
# changes, which silently kills any in-flight ingest job (the in-memory
# queue never reports back). Off by default; set to 1 while editing code,
# and leave unset for demos/rehearsals.
# DEV_RELOAD=1

# Comma-separated list of origins allowed by CORS. Defaults to localhost:8000.
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Optional: shared-secret auth for mutating routes (ingest, delete source,
# clear graph). Leave unset to disable auth entirely (fine for local/hackathon
# use). When set, clients must send it as the X-API-Key header.
# API_KEY=your_shared_secret_here

# Optional: auto-merge exact-duplicate entities at ingest (suggest-only when unset)
# AUTO_MERGE=exact

# Per-IP request cap (requests / 60s window), shared across /ingest/* and /ask.
# Raise this before a demo if you'll rehearse and then present back-to-back —
# the bucket is per-process and does not reset between runs. Default: 10.
# RATE_LIMIT_MAX=10

# Max seconds a single background ingest job may run before it's force-failed
# with "timed out". Default: 600.
# INGEST_JOB_TIMEOUT=600

# How many sandboxes POST /graph/verify/fanout may have in flight at once.
# Each source gets its own sandbox; this caps the burst so a demo-sized graph
# doesn't ask Daytona for more sandboxes than intended. Clamped to 1..32.
# Default: 6. Set it to whatever your plan's concurrent-CPU ceiling allows —
# the sweep endpoint reports an over-budget batch as `short_by` rather than
# pretending the run was clean, and Daytona answers with a 400 "Total CPU limit
# exceeded" per refused sandbox.
# FANOUT_MAX_CONCURRENCY=10

# Node budget for the betweenness-centrality pass in GET /graph/analytics.
# Above this many nodes the analytics sandbox skips betweenness (it is
# O(N*E)) and reports it as skipped rather than timing out. Clamped to 1..5000.
# Default: 400.
# ANALYTICS_MAX_BETWEENNESS_NODES=400

# Optional: base URL the Streamlit dashboard (frontend/app.py) uses to reach
# this API. Defaults to http://localhost:8000 when unset.
# GRAPHAGENT_API=http://localhost:8000
